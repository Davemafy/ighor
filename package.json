{
  "name": "igor-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src tests scripts next.config.ts eslint.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config tests/vitest.config.mts",
    "test:connected:browser": "playwright test --config tests/connected-work.playwright.config.mts",
    "test:e2e": "node scripts/check-browser.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run test:eval && npm run build",
    "prebuild": "node scripts/clean-build.mjs",
    "dev:recorded": "node scripts/dev-recorded.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "verify:all": "npm run verify && npm run test:browser",
    "test:eval": "node --test scripts/igor-blind-eval.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "tabWidth": 2
  }
}
