# Igor: server-only credentials. Do not commit real values.
# No fixture mode should be enabled for paid-provider acceptance.
QLOO_API_KEY=
QLOO_MAX_CALLS=30
QLOO_CACHE_DAYS=1
QLOO_CACHE_ONLY=0

# Public-web research. SERP zone name must match the actual Bright Data dashboard.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=gor_serp
# Enable ONLY if a Web Unlocker zone has been created.
BRIGHTDATA_UNLOCKER_ZONE=

# Choose one primary model; add another provider for a read-only fallback.
IGOR_MODEL_PROVIDER=grok
XAI_API_KEY=
# XAI_MODEL=<verified model ID>
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=<verified model ID>
GEMINI_API_KEY=
# GEMINI_MODEL=<verified model ID>
LLM_API_KEY=
LLM_MODEL=

# Google Places API (New). No API keys are delivered to clients.
GOOGLE_MAPS_API_KEY=

# Browserbase cloud browser, server-only. Browser actions are read-only in this PR.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Per-task agent hard bounds, validated and clamped by the runtime.
IGOR_AGENT_MAX_STEPS=4
IGOR_AGENT_MAX_REQUESTS=8

# Optional persistent Railway volume path overrides. Use a durable volume!
# IGOR_DB_PATH=/data/igor/workspace.sqlite
# IGOR_AUTH_PATH=/data/igor/auth.sqlite
# IGOR_CACHE_PATH=/data/igor/qloo-cache.sqlite

# Never enable these for live production validation:
# IGOR_TEST_FIXTURES=0
# IGOR_QLOO_RECORDING=
